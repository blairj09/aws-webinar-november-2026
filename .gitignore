# Whitelist: only public material is tracked.
# Notes, drafts and setup stay local. The deck's raw screenshots stay local too.
/*
!/.gitignore
!/README.md
!/.Rprofile
!/renv.lock
!/renv/
!/_quarto.yml
!/_quarto-publish.yml
!/index.qmd
!/landing.css
!/assets/
!/strip-notes.lua
!/publish.sh
!/security-guide/
!/deck/
!/commons-aurora/
!/posit-assistant-eda/
!/bedrock-usage-dashboard/

# Render outputs and local-only files inside the tracked folders
/.quarto/
/_site/
**/.quarto/
.DS_Store
*.annotations.json
/deck/_publish.yml
/deck/assets/screens/raw/
/deck/rsconnect-python/
/deck/webinar.html
/deck/webinar_files/
/security-guide/security-guide.html
/security-guide/security-guide.pdf
/security-guide/security-guide.typ
/security-guide/security-guide_files/
/commons-aurora/commons-cache/
/commons-aurora/.shinychat/
/commons-aurora/rsconnect/
/posit-assistant-eda/*.html
/posit-assistant-eda/*_files/
/posit-assistant-eda/brief.*
/bedrock-usage-dashboard/*.html
/bedrock-usage-dashboard/*_files/

**/*.quarto_ipynb
